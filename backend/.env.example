# --- Database ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=fitness
PGUSER=fitapp
PGPASSWORD=fitpass

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Dev mode: OTP / reset codes are logged and returned in API responses.
# Set to false in production.
OTP_DEV_MODE=true

# --- Email (v0.5) — leave unset to run in dev mode (codes in server logs).
# Works with any SMTP provider (Gmail app password, SendGrid, Mailgun, ...).
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=user-or-apikey
#SMTP_PASS=secret
#SMTP_FROM="Apex Fitness <no-reply@example.com>"

# --- Zoom (v0.5) — leave unset for placeholder links (they will show
# "invalid meeting ID" in Zoom, which is expected in dev).
# Create a Server-to-Server OAuth app at marketplace.zoom.us and fill these:
#ZOOM_ACCOUNT_ID=
#ZOOM_CLIENT_ID=
#ZOOM_CLIENT_SECRET=

# --- Production (v0.13) ---
# Set NODE_ENV=production on your server. The API then REFUSES to start if
# OTP_DEV_MODE is true or JWT_SECRET is still the default — this prevents
# shipping a build that returns verification codes in API responses.
#NODE_ENV=production
# Generate with: openssl rand -base64 48
#JWT_SECRET=
# Browser origins allowed to call the API (comma separated). The mobile app
# sends no Origin header and is unaffected. Leave empty to allow all.
#CORS_ORIGINS=https://coachlyjo.com,https://www.coachlyjo.com
# Public base URL, used in the store listings:
#   https://<your-domain>/privacy          -> privacy policy URL (both stores)
#   https://<your-domain>/terms            -> terms of service
#   https://<your-domain>/delete-account   -> account deletion URL (Play Console)

# Local development only: allow fake Zoom links so the booking flow can be
# tested without Zoom credentials. NEVER set this in production — a member
# would receive a link that does not work.
#ZOOM_ALLOW_PLACEHOLDER=true

# --- Push notifications (v0.14) ---
# From the Firebase service-account JSON. Without these, notifications stay
# in-app and by email; nothing errors. See README "Push notifications".
#FIREBASE_PROJECT_ID=
#FIREBASE_CLIENT_EMAIL=
#FIREBASE_PRIVATE_KEY=
